{
  "name": "claude-code-insights-vscode",
  "publisher": "ijuani",
  "displayName": "Claude Code Insights",
  "description": "Real-time insights for Claude Code: usage and rate limits, background agent monitoring, conversation viewer, and session browser",
  "icon": "favicon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IJuanI/claude-insights"
  },
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudeCodeInsights.agentEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeInsights.refresh",
        "title": "Claude Code Insights: Refresh Usage"
      },
      {
        "command": "claudeCodeInsights.openPanel",
        "title": "Claude Code Insights: Open Usage Panel"
      },
      {
        "command": "claudeCodeInsights.toggleDebug",
        "title": "Claude Lens: Toggle Debug Mode"
      },
      {
        "command": "claudeCodeInsights.copyDebugInfo",
        "title": "Claude Lens: Copy Diagnostics"
      },
      {
        "command": "claudeCodeInsights.showAgentLogs",
        "title": "Claude Lens: Show Logs"
      },
      {
        "command": "claudeCodeInsights.openAgents",
        "title": "Claude Lens",
        "icon": {
          "light": "media/agents-icon-light.svg",
          "dark": "media/agents-icon.svg"
        }
      },
      {
        "command": "claudeCodeInsights.searchSessions",
        "title": "Claude Sessions: Search",
        "icon": "$(search)"
      },
      {
        "command": "claudeCodeInsights.clearSessionSearch",
        "title": "Claude Sessions: Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCodeInsights.refreshSessions",
        "title": "Claude Sessions: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeCodeInsights.deepSearch",
        "title": "Claude Sessions: Deep Search (content)"
      },
      {
        "command": "claudeCodeInsights.copySessionId",
        "title": "Copy Id"
      },
      {
        "command": "claudeCodeInsights.copyAgentId",
        "title": "Copy Id"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claudeCodeInsights.openAgents",
          "when": "claudeCodeInsights.hasBackgroundAgents && (activeWebviewPanelId == claudeVSCodePanel || claude-vscode.sideBarActive)",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "claudeCodeInsights.searchSessions",
          "when": "view == claudeCodeInsights.sessionTree",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeInsights.clearSessionSearch",
          "when": "view == claudeCodeInsights.sessionTree && claudeCodeInsights.sessionSearchActive",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeInsights.refreshSessions",
          "when": "view == claudeCodeInsights.sessionTree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": []
    },
    "views": {
      "claude-sessions-sidebar": [
        {
          "type": "webview",
          "id": "claudeCodeInsights.sessionTree",
          "name": "Sessions"
        },
        {
          "type": "webview",
          "id": "claudeCodeInsights.agentView",
          "name": "Claude Lens"
        },
        {
          "type": "webview",
          "id": "claudeCodeInsights.usageView",
          "name": "Claude Usage"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Insights",
      "properties": {
        "claudeCodeInsights.refreshInterval": {
          "type": "number",
          "default": 60,
          "description": "How often to refresh usage data (seconds)"
        },
        "claudeCodeInsights.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Show debug toolbar in Claude Agents panel (workspace/session selectors)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap && esbuild src/searchWorker.ts --bundle --outfile=dist/searchWorker.js --format=cjs --platform=node --minify --sourcemap && esbuild src/agentWebviewClient/index.ts --bundle --outfile=dist/agentWebviewClient.js --format=iife --platform=browser --minify --sourcemap",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.27.4",
    "playwright": "^1.58.2",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  }
}
